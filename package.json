    "lucide-react": "^0.469.0",
    "next": "15.1.11",
    "next-auth": "^4.24.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
