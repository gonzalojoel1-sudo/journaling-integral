{
  "name": "journaling-integral",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm -w @journaling/api run dev",
    "dev:web": "npm -w @journaling/web run dev",
    "build": "npm -w @journaling/web run build",
    "lint": "npm -w @journaling/web run lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx packages/api/src/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
