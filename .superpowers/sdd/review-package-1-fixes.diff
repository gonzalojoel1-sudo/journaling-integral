+      entryId: journalEmbeddings.entryId,
+      content: journalEmbeddings.content,
+      createdAt: journalEmbeddings.createdAt,
+    })
+    .from(journalEmbeddings)
+    .orderBy(desc(journalEmbeddings.createdAt))
+    .limit(10);
